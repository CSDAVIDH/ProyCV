# Upstash Redis — Contador de visitas persistente
# Crie sua conta gratuita em: https://upstash.com
# 1. Crie um banco Redis (plano Free)
# 2. Copie as credenciais REST abaixo

UPSTASH_REDIS_REST_URL=https://SEU_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_AQUI

# CountAPI é um backup opcional se você não usar Upstash.
# Se quiser, configure um namespace próprio ou use o padrão.
COUNTAPI_NAMESPACE=david-condori-portfolio
