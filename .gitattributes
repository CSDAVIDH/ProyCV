# Normaliza finales de línea en texto plano para todos los colaboradores.
# Esto evita warnings de LF/CRLF en Windows y mantiene la compilación consistente.
* text=auto
*.ts text
*.tsx text
*.js text
*.jsx text
*.css text
*.html text
*.json text
*.md text
*.yml text
*.yaml text
*.env text eol=lf
*.env.* text eol=lf
.gitattributes text eol=lf
